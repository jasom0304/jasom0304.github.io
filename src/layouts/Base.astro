---
import '../styles/global.css';
import { categories, ui, site, type Lang } from '../site';
import { href, asset } from '../lib/url';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** 不含語言的路徑，例如 'exchange/my-post/'。用來連到另一種語言的同一頁。 */
  path?: string;
  /** 另一種語言有沒有同一頁。沒有就連到首頁。 */
  hasAlt?: boolean;
  current?: string;
}

const { lang, title, description, path = '', hasAlt = true, current } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const pageTitle = title ? `${title}｜${t.siteName}` : t.siteName;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hant' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t.description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description ?? t.description} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="alternate" hreflang={other === 'zh' ? 'zh-Hant' : 'en'} href={href(other, hasAlt ? path : '')} />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved) document.documentElement.dataset.theme = saved;
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=LXGW+WenKai+TC:wght@400;700&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&family=Noto+Serif+TC:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <a class="site-name" href={href(lang)}>{t.siteName}</a>
      <nav aria-label={t.navLabel}>
        <ul>
          {
            categories.map((c) => (
              <li>
                <a href={href(lang, `${c.id}/`)} aria-current={current === c.id ? 'page' : undefined}>
                  {c[lang].name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="tools">
        <a href={href(other, hasAlt ? path : '')} lang={other === 'zh' ? 'zh-Hant' : 'en'}>{t.switchLang}</a>
        <button type="button" id="theme-toggle" aria-pressed="false">{t.theme}</button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>© {year} {t.author}</p>
      {
        site.email && (
          <p>
            {t.contact}
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        )
      }
    </footer>

    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        var root = document.documentElement;
        function isDark() {
          if (root.dataset.theme) return root.dataset.theme === 'dark';
          return window.matchMedia('(prefers-color-scheme: dark)').matches;
        }
        function sync() {
          btn.setAttribute('aria-pressed', String(isDark()));
        }
        btn.addEventListener('click', function () {
          var next = isDark() ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
          sync();
        });
        sync();
      })();
    </script>
  </body>
</html>
